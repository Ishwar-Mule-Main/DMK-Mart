# ═══════════════════════════════════════════════════════════════
# DMK Mart ERP — VERCEL environment template
# Copy each value into: Vercel Dashboard → Project → Settings →
# Environment Variables (Production + Preview).
# Full walkthrough: docs/deploy/vercel.md
# ═══════════════════════════════════════════════════════════════

# ─── REQUIRED ───────────────────────────────────────────────────
# Postgres connection string (Neon / Supabase / Vercel Postgres).
# Use the POOLED connection URL for serverless (Neon: the "-pooler"
# hostname; Supabase: the "Transaction pooler" URL on port 6543).
# The schema was already pushed with:  bun run db:push:pg
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dmk?sslmode=require"

# ─── RECOMMENDED ────────────────────────────────────────────────
# Protects GET /api/v1/recurring/generate (the Vercel Cron ping that
# drives recurring auto-posting on serverless). Vercel automatically
# sends this value as `Authorization: Bearer <CRON_SECRET>` when the
# env var name is exactly CRON_SECRET.
CRON_SECRET=generate-a-long-random-string

# ─── AI COPILOT (optional) ──────────────────────────────────────
# Without these the app works fully — the copilot answers with a
# friendly "not configured" note instead of an AI reply.
# Any OpenAI-compatible provider works:
#   OpenRouter: https://openrouter.ai/api/v1
#   Ollama:     http://<your-host>:11434/v1
AI_BASE_URL="https://openrouter.ai/api/v1"
AI_API_KEY="sk-or-v1-xxxxxxxxxxxxxxxxxxxx"
AI_MODEL="z-ai/glm-5.3-flash"

# ─── SET AUTOMATICALLY BY VERCEL (do not add manually) ─────────
# VERCEL=1            — skips the in-process scheduler & standalone output
# CRON related headers — sent by Vercel Cron itself
